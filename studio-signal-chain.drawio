<mxfile host="Electron" agent="Claude Code" version="29.6.6">
  <diagram name="Overview" id="d1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="src_tt" value="Technics MK7" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="src_koii" value="TE KOII" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ecler" value="Ecler Nuo2&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;DJ mixer — heavy EQ on the way in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mpc2500" value="Akai MPC2500" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mpc2000" value="Akai MPC2000" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="palmer" value="Palmer Pan 16&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;passive DI, merge mode&lt;br&gt;one MPC active per project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="190" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s950" value="Akai S950&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;12-bit mono · source / character sampler&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="vermona" value="Vermona Filter Lancet&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;in-line — HP / LP / BP band-split&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="190" height="65" as="geometry" />
        </mxCell>

        <mxCell id="tascam" value="Tascam Model 2400&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;24-ch console + 24x22 USB interface — the hub.&lt;br&gt;Sound modeling is decided and printed here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="50" width="420" height="640" as="geometry" />
        </mxCell>

        <mxCell id="chmap" value="&lt;b&gt;Channel map&lt;/b&gt;&lt;br&gt;1&amp;nbsp; kick&amp;nbsp; — insert SPL 1&amp;nbsp; → sub 1/2&lt;br&gt;2&amp;nbsp; snare — insert SPL 2&amp;nbsp; → sub 1/2&lt;br&gt;3&amp;nbsp; hi-hat — insert SPL 3 → sub 1/2&lt;br&gt;4-8&amp;nbsp; perc, bass, instrumental samples&lt;br&gt;9&amp;nbsp; &lt;i&gt;free&lt;/i&gt;&lt;br&gt;10&amp;nbsp; Akai S950 (mono) — insert SPL 4&lt;br&gt;11/12&amp;nbsp; MPC2000 stereo out&lt;br&gt;13/14&amp;nbsp; MPC2500 stereo out&lt;br&gt;15/16&amp;nbsp; Ecler Nuo2&lt;br&gt;17/18&amp;nbsp; Alesis XT:C return (EQ'd)&lt;br&gt;19/20&amp;nbsp; DBX 266XL return — &lt;b&gt;parallel&lt;/b&gt;&lt;br&gt;21/22&amp;nbsp; Mac / Reaper — &lt;b&gt;mute on capture&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="595" y="130" width="370" height="250" as="geometry" />
        </mxCell>

        <mxCell id="busmap" value="&lt;b&gt;Subgroups&lt;/b&gt;&lt;br&gt;1/2 → DBX 266XL → back in ch 19/20 (glue)&lt;br&gt;3/4 → &lt;b&gt;stereo&lt;/b&gt; → MPC2000 sample-in&lt;br&gt;5/6 → &lt;b&gt;stereo&lt;/b&gt; → MPC2500 sample-in&lt;br&gt;&lt;br&gt;&lt;b&gt;Aux sends&lt;/b&gt;&lt;br&gt;aux 1 → &lt;b&gt;mono&lt;/b&gt; → Akai S950 sample-in&lt;br&gt;aux 4 → Alesis XT:C&lt;br&gt;aux 2, 3, 5 → &lt;i&gt;free&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="595" y="400" width="370" height="160" as="geometry" />
        </mxCell>

        <mxCell id="capture" value="&lt;b&gt;USB capture — post-FX, pre-fader&lt;/b&gt;&lt;br&gt;EQ + SPL print · the balance does not&lt;br&gt;every channel tracked at ≈ −10 dBFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="595" y="580" width="370" height="70" as="geometry" />
        </mxCell>

        <mxCell id="spl" value="SPL Transient Designer&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;4 ch — inserts on ch 1, 2, 3 + ch 10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1090" y="70" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="dbx" value="DBX 266XL&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;2 ch, stereo-couple ON&lt;br&gt;&lt;b&gt;parallel&lt;/b&gt; drum glue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1090" y="200" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="xtc" value="Alesis XT:C&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;reverb — mainly the snare&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1090" y="340" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lexicon" value="Lexicon MPX100&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;out of service — still racked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=13;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="430" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mac" value="Apple Studio M4&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Reaper — mixing + mastering&lt;br&gt;&lt;i&gt;detail on the &amp;quot;Mixing and mastering&amp;quot; tab&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="760" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mon" value="Monitors" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="760" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Tascam 2400 = console + USB interface in one (replaced the Scarlett)&lt;br&gt;• Palmer merges the MPC 8-outs → ch 1-8; one MPC active per project&lt;br&gt;• Capture is &lt;b&gt;post-FX and pre-fader&lt;/b&gt;: the multitrack is a level-normalised archive, not a mix. The leveling is recreated at the mixing step&lt;br&gt;• Pass 1 = stereo master (the mix, every beat)&lt;br&gt;&amp;nbsp;&amp;nbsp; Pass 2 = per-channel multitrack (every beat, same take)&lt;br&gt;• DBX is &lt;b&gt;parallel&lt;/b&gt;, not an insert — the dry/crushed ratio is re-creatable later, but not recallable (it lived in the faders)&lt;br&gt;• &lt;b&gt;Analog gear = sound modeling that cannot be changed. The DAW = mixing.&lt;/b&gt;&lt;br&gt;• Mix and master are separate Reaper projects — see manual_mixing_tascam_reaper.md&lt;br&gt;&lt;br&gt;&lt;b&gt;Line key&lt;/b&gt;&lt;br&gt;— solid = audio path&lt;br&gt;— red dashed = sample / re-sample send back into a sampler&lt;br&gt;— grey dashed = out of service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="530" width="420" height="312" as="geometry" />
        </mxCell>

        <mxCell id="e_tt" value="phono in 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="src_tt" target="ecler">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_koii" value="line in 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="src_koii" target="ecler">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
