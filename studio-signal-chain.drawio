        </mxCell>

        <mxCell id="e_s950v" value="main out (mono)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="s950" target="vermona">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_v10" value="→ ch 10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="vermona" target="tascam">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_aux1" value="aux 1 — mono sample-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="tascam" target="s950">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="520" y="670" /><mxPoint x="520" y="620" /><mxPoint x="135" y="620" /></Array>
          </mxGeometry>
