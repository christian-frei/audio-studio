        <mxCell id="e_sub56" value="subgroup 5/6 → MPC2500" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.12;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tascam" target="mpc2500">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="620" y="26" /><mxPoint x="258" y="26" /><mxPoint x="258" y="295" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sub34" value="subgroup 3/4 → MPC2000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tascam" target="mpc2000">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="654" y="12" /><mxPoint x="276" y="12" /><mxPoint x="276" y="375" /></Array>
          </mxGeometry>
