        </mxCell>
        <mxCell id="e_2500st" value="stereo L/R → ch 13/14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="mpc2500" target="tascam">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="530" y="283" /><mxPoint x="530" y="230" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_2000st" value="stereo L/R → ch 11/12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="mpc2000" target="tascam">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="545" y="388" /><mxPoint x="545" y="410" /></Array>
